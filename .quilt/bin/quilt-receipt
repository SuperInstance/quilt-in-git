#!/bin/sh
# quilt-receipt — write .quilt/receipts/<short>.json for HEAD.
#
# Fields: commit (full hash), changed_cells (aliases under cells/ touched by
# HEAD), key_dials (per cell: obstruction = dial 1, freeze = dial 15, read
# from the committed tree), ts, sig. The timestamp is the git commit time
# (`git log -1 --format=%ct`) — never wall clock — so receipts are
# deterministic and reproducible from history alone.
#
# sig = fnv1a-64 over  BODY || committer-ident || commit-tree  where BODY is
# the receipt text below up to and including the trailing comma after "ts"
# (i.e. the whole receipt except the sig field, no trailing newline), the
# committer ident is the raw `committer ...` header of HEAD, and the tree is
# HEAD^{tree}. A cheap TRANSPORT-LEVEL integrity mark — recomputable by
# .quilt/bin/quilt-verify — tying the receipt to THAT commit by THAT actor.
# fnv1a-64 is a checksum, not cryptography: it catches transport damage and
# un-reforged edits, not an adversary who recomputes it.
#
# Echoes the short hash on success (used by the post-commit hook).

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 1
cd "$ROOT" || exit 1
mkdir -p .quilt/receipts

FULL=$(git rev-parse HEAD)
SHORT=$(git rev-parse --short HEAD)
TS=$(git log -1 --format=%ct HEAD)
CELLS=$(git diff-tree --root --no-commit-id --name-only -r HEAD -- cells/ \
        | cut -d/ -f2 | sort -u)

# dial value from the committed tree, coerced to a number, 0 when absent
committed_dial() { # committed_dial <alias> <n>
  git show "HEAD:cells/$1/dials/$2" 2>/dev/null \
    | awk '{printf "%g", $1 + 0; found=1} END{if (!found) printf "0"}'
}

cell_list=""
dial_json=""
n=0
for c in $CELLS; do
  n=$((n + 1))
  if [ $n -eq 1 ]; then cell_list="\"$c\""; else cell_list="$cell_list, \"$c\""; fi
  obs=$(committed_dial "$c" 1)
  frz=$(committed_dial "$c" 15)
  dial_json="$dial_json    \"$c\": {\"obstruction\": $obs, \"freeze\": $frz},
"
done
dials=""
[ -z "$dial_json" ] || dials=$(printf '%s' "$dial_json" | sed '$ s/,$//')

BODY=$(printf '{\n  "commit": "%s",\n  "changed_cells": [%s],\n  "key_dials": {\n%s\n  },\n  "ts": %s,' \
  "$FULL" "$cell_list" "$dials" "$TS")
IDENT=$(git cat-file commit HEAD | sed -n 's/^committer //p')
TREE=$(git rev-parse 'HEAD^{tree}')
SIG=$(printf '%s%s%s' "$BODY" "$IDENT" "$TREE" | .quilt/bin/quilt-fnv1a)

printf '%s\n  "sig": "%s"\n}\n' "$BODY" "$SIG" > ".quilt/receipts/$SHORT.json"

echo "$SHORT"
