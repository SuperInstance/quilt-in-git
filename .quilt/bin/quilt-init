#!/bin/sh
# quilt-init — bootstrap the quilt runtime inside a git repository.
#
#   mkdir -p cells .quilt/{receipts,bin,hooks}
#   git config core.hooksPath .quilt/hooks      (modern git; no .git/hooks symlinks)
#   (re)write .quilt/hooks/{pre-commit,post-commit}, chmod +x
#
# Idempotent: safe to re-run. The hook files are generated from this script —
# edit quilt-init, not the hook files. MUST be run once per clone: the hooks
# travel with the repository but core.hooksPath is local config and never
# does.

set -e

ROOT=$(git rev-parse --show-toplevel) \
  || { echo "quilt-init: not inside a git repository" >&2; exit 1; }
cd "$ROOT"

mkdir -p cells .quilt/receipts .quilt/bin .quilt/hooks
git config core.hooksPath .quilt/hooks

# ---------------------------------------------------------------- pre-commit
cat > .quilt/hooks/pre-commit <<'QUILT_HOOK_EOF'
#!/bin/sh
# quilt pre-commit — FREEZE enforcement.
#
# A cell whose COMMITTED dial 15 (FREEZE) is > 0.5 rejects any staged change
# to that cell. Staged paths that are only cells/<alias>/dials/15 are always
# allowed, so a freeze can always be set or lifted (in its own commit).
# Arithmetic uses awk, not bc (bc may be absent).

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$ROOT" || exit 1

STAGED=$(git diff --cached --name-only -- cells/ | sort -u)
[ -n "$STAGED" ] || exit 0

for alias in $(printf '%s\n' "$STAGED" | cut -d/ -f2 | sort -u); do
  others=$(printf '%s\n' "$STAGED" | grep "^cells/$alias/" \
           | grep -v "^cells/$alias/dials/15$" || true)
  [ -n "$others" ] || continue   # freeze management only — allowed
  frz=$(git show "HEAD:cells/$alias/dials/15" 2>/dev/null | tr -d '[:space:]')
  frz=${frz:-0}
  if awk -v f="$frz" 'BEGIN{exit !(f + 0 > 0.5)}'; then
    echo "ERROR: cell $alias is frozen (dial 15 = $frz)" >&2
    echo "       unfreeze first: .quilt/bin/quilt-tick $alias 15 0.0" >&2
    exit 1
  fi
done
exit 0
QUILT_HOOK_EOF

# --------------------------------------------------------------- post-commit
cat > .quilt/hooks/post-commit <<'QUILT_HOOK_EOF'
#!/bin/sh
# quilt post-commit — the tick engine.
#
# For a commit that touches cells/:
#   1. .quilt/bin/quilt-receipt  writes .quilt/receipts/<short>.json
#   2. .quilt/bin/quilt-cascade  recomputes dial 14 of linked cells
#   3. if cascade changed dial files: git add cells/ and auto-commit
#      "quilt: cascade after <short>" with --no-verify
#   4. append "tick <short> <short> <cells>" to .quilt/watch.log
#
# Commits touching no cells/ path exit 0 silently, as do the hook's own
# "quilt: cascade after ..." commits (no recursion).

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$ROOT" || exit 1

case "$(git log -1 --format=%s HEAD)" in
  "quilt: cascade after"*) exit 0 ;;
esac

CELL_PATHS=$(git diff-tree --root --no-commit-id --name-only -r HEAD -- cells/)
[ -n "$CELL_PATHS" ] || exit 0

SHORT=$(git rev-parse --short HEAD)
CELLS=$(printf '%s\n' "$CELL_PATHS" | cut -d/ -f2 | sort -u | paste -sd, -)

.quilt/bin/quilt-receipt >/dev/null
.quilt/bin/quilt-cascade

if [ -n "$(git status --porcelain -- cells/)" ]; then
  git add cells/
  git commit --no-verify -qm "quilt: cascade after $SHORT" >/dev/null 2>&1
fi

mkdir -p .quilt
printf 'tick %s %s %s\n' "$SHORT" "$SHORT" "$CELLS" >> .quilt/watch.log
exit 0
QUILT_HOOK_EOF

chmod +x .quilt/hooks/pre-commit .quilt/hooks/post-commit
for b in .quilt/bin/quilt-*; do
  [ -f "$b" ] && chmod +x "$b"
done
touch .quilt/watch.log

echo "quilt: initialised at $ROOT"
echo "quilt: hooks active (core.hooksPath=.quilt/hooks)"
echo "quilt: ticks are ordinary commits touching cells/ — try .quilt/bin/quilt-tick <alias> <dial> <value>"
