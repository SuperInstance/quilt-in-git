#!/bin/sh
# quilt post-commit — the tick engine (w3 union: notes + sparse-detection + publish).
#
# For a commit that touches cells/:
#   1. .quilt/bin/quilt-receipt  writes .quilt/receipts/<short>.json
#   2. git notes --ref=quilt/receipts attaches that same receipt JSON to the
#      commit — notes are real git objects, so receipts ride fetch/push/
#      clone with the branch (the .quilt/receipts/ files never leave the
#      working tree)
#   3. .quilt/bin/quilt-cascade  recomputes dial 14 of linked cells (it
#      reads and stages the INDEX, so it works under quilt-focus too)
#   4. if the index now differs from HEAD under cells/: sweep any dirty
#      materialized files (git add cells/) and auto-commit
#      "quilt: cascade after <short>" with --no-verify
#   5. append "tick <short> <short> <cells>" to .quilt/watch.log
#   6. .quilt/bin/quilt-publish snapshots the dials into the orphan ref
#      refs/quilt/dials and the vitals into refs/quilt/HEAD — after the
#      watch line, so watch_tail includes this tick
#
# Change detection is `git diff --cached HEAD -- cells/` — index vs HEAD,
# never the worktree — so the cascade commit fires identically in a full
# and in a sparse (focused) worktree. Out-of-focus cells are never swept
# by the git add (sparse entries are skipped by design); their dial
# updates are already staged by quilt-cascade itself.
#
# Commits touching no cells/ path exit 0 silently, as do the hook's own
# "quilt: cascade after ..." commits (no recursion, no receipt, no note).

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$ROOT" || exit 1

case "$(git log -1 --format=%s HEAD)" in
  "quilt: cascade after"*) exit 0 ;;
esac

CELL_PATHS=$(git diff-tree --root --no-commit-id --name-only -r HEAD -- cells/)
[ -n "$CELL_PATHS" ] || exit 0

SHORT=$(git rev-parse --short HEAD)
CELLS=$(printf '%s\n' "$CELL_PATHS" | cut -d/ -f2 | sort -u | paste -sd, -)

.quilt/bin/quilt-receipt >/dev/null
if [ -f ".quilt/receipts/$SHORT.json" ]; then
  git notes --ref=quilt/receipts add -f -F ".quilt/receipts/$SHORT.json" HEAD \
    >/dev/null 2>&1 || true
fi
.quilt/bin/quilt-cascade

git add cells/ 2>/dev/null || true
if ! git diff --cached --quiet HEAD -- cells/ 2>/dev/null; then
  git commit --no-verify -qm "quilt: cascade after $SHORT" >/dev/null 2>&1
fi

mkdir -p .quilt
printf 'tick %s %s %s\n' "$SHORT" "$SHORT" "$CELLS" >> .quilt/watch.log
.quilt/bin/quilt-publish >/dev/null
exit 0
